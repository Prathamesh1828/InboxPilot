# Application
APP_NAME=InboxPilot
ENVIRONMENT=production
DEBUG=False
FRONTEND_URL=https://your-frontend-domain.com
API_KEY=your_secure_production_api_key_here

# Database
DATABASE_URL=postgresql+psycopg://username:password@hostname/dbname?sslmode=require
LOCAL_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/inboxpilot

# Redis (Celery)
REDIS_URL=rediss://default:password@hostname:port

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-api-domain.com/auth/gmail/callback

# Session Support
SESSION_SECRET=a_very_long_random_secure_string_here
OAUTHLIB_INSECURE_TRANSPORT=0

# LLM Configuration
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=your_groq_api_key_here

LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-3.6-flash
LLM_FALLBACK_API_KEY=your_gemini_api_key_here

# LLM Behavior
LLM_CONFIDENCE_THRESHOLD=0.85
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_telegram_bot_username_here
TELEGRAM_WEBHOOK_SECRET=your_secure_webhook_secret_here

# Email Field Encryption (AES-256-GCM)
# Generate: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Store ONLY in environment/secret manager — never commit to source control.
EMAIL_ENCRYPTION_KEY=your_32_byte_base64url_key_here